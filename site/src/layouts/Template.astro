---
/**
 * Shared page chrome (descendant of resources/views/template.blade.php).
 *
 * The client stack is dependency-free: assets/js/targygraf.js is a vanilla
 * rewrite of the original jQuery implementation (same DOM contract, same
 * localStorage format — see its header), tooltips reuse tipsy.css via a
 * small built-in replacement, and the legal notice is self-rendered.
 */
import { DEFAULT_DESCRIPTION, pageTitle } from '../lib/render';
import { siteOrigin } from '../lib/urls';

interface Props {
	/**
	 * Which chrome variant to render. Program pages keep the legacy
	 * no-viewport, fixed-min-width behavior so the graph renders zoomed-out
	 * on phones; home and university pages are properly responsive.
	 */
	page: 'home' | 'university' | 'program';
	/** Page-specific title part; template appends " | Tárgygráf". */
	htmlTitle?: string;
	description?: string;
	/** Absolute canonical URL; rendered only when provided. */
	canonical?: string;
}

const { page, htmlTitle, description = DEFAULT_DESCRIPTION, canonical } = Astro.props;
const title = pageTitle(htmlTitle);
const origin = siteOrigin();
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="utf-8" />
		<meta
			name="keywords"
			content="tárgygráf, pannon egyetem, pe, bme, pte, pécs, műszaki, műegyetem, tanterv, mintatanterv, egyetem, pannon, gráf, kredit, félév, tárgyak, tárgy, tantárgy, előfeltétel, előtanulmány, előtanulmányi rend, ráépülés"
		/>
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta property="og:site_name" content="Tárgygráf" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="hu_HU" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={`${origin}/og.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Tárgygráf: a mintatanterved, interaktív térképen" />
		{
			/* Program pages deliberately ship no viewport meta: the graph relies
			   on the fixed-min-width layout rendering zoomed-out on phones. */
			page !== 'program' && (
				<meta name="viewport" content="width=device-width, initial-scale=1" />
			)
		}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<link href="/assets/css/style.css?v=20260831" rel="stylesheet" />
		<link href="/assets/css/tipsy.css?v=20260831" rel="stylesheet" />
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1T3XF9V5BL"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-1T3XF9V5BL');
		</script>
	</head>
	<body class={`page-${page}`}>
		<div class="fade"></div>

		<div class="buttons">
			<slot name="buttons" />
		</div>

		<header>
			<slot name="header" />
		</header>

		<main>
			<slot name="main" />
		</main>

		<footer>
			<div class="footer-inner">
				<span class="disclaimer"
					>Hallgatók által szerkesztett, tájékoztató jellegű oldal. A hivatalos tantervet mindig
					az egyetemednél ellenőrizd.</span
				>
				<span class="footer-links">
					<a href="https://github.com/0xb4lint/targygraf" rel="noopener">GitHub</a>
					<span class="sep" aria-hidden="true">·</span>
					<a href="https://b4lint.hu" rel="noopener">Szekeres Bálint</a>
				</span>
			</div>
		</footer>

		<script is:inline src="/assets/js/targygraf.js?v=20260831"></script>
	</body>
</html>
