---
/**
 * Port of resources/views/template.blade.php.
 *
 * The client stack is dependency-free: assets/js/targygraf.js is a vanilla
 * rewrite of the original jQuery implementation (same DOM contract, same
 * localStorage format — see its header), tooltips reuse tipsy.css via a
 * small built-in replacement, and notie remains for the legal toast.
 */
import { DEFAULT_DESCRIPTION, pageTitle } from '../lib/render';
import { siteOrigin } from '../lib/urls';

interface Props {
	/** Page-specific title part; template appends " | Tárgygráf". */
	htmlTitle?: string;
	description?: string;
	/** Absolute canonical URL; rendered only when provided. */
	canonical?: string;
	/**
	 * University slug whose legacy subdomain localStorage should be migrated
	 * into this origin (see public/assets/js/ls-migrate.js).
	 */
	migrateUniversity?: string;
}

const { htmlTitle, description = DEFAULT_DESCRIPTION, canonical, migrateUniversity } = Astro.props;
const title = pageTitle(htmlTitle);
const origin = siteOrigin();
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta
			name="keywords"
			content="tárgygráf, pannon egyetem, pe, bme, pte, pécs, műszaki, műegyetem, tanterv, mintatanterv, egyetem, pannon, gráf, kredit, félév, tárgyak, tárgy, tantárgy, előfeltétel, előtanulmány, előtanulmányi rend, ráépülés"
		/>
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${origin}/icon.png`} />
		<meta property="og:type" content="website" />
		<meta property="fb:admins" content="1412307634" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		{/* Deliberately no viewport meta: the live site has none, and adding one
		    would change how the fixed-min-width layout renders on phones. */}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/png" href="/icon.png" />
		<link rel="apple-touch-icon" href="/icon.png" />
		<link
			href="https://fonts.googleapis.com/css?family=Open+Sans:300,400&subset=cyrillic,cyrillic-ext,greek,greek-ext,latin-ext,vietnamese"
			rel="stylesheet"
		/>
		<link
			href="https://netdna.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css"
			rel="stylesheet"
		/>
		<link href="/assets/css/style.css?v=20190217" rel="stylesheet" />
		<link href="/assets/css/tipsy.css" rel="stylesheet" />
		<link href="/assets/css/notie.min.css" rel="stylesheet" />
		<script is:inline type="text/javascript">
			(function (d, s, id) {
				var js,
					fjs = d.getElementsByTagName(s)[0];
				if (d.getElementById(id)) return;
				js = d.createElement(s);
				js.id = id;
				js.src = '//connect.facebook.net/hu_HU/sdk.js#xfbml=1&version=v2.10&appId=233475786671363';
				fjs.parentNode.insertBefore(js, fjs);
			})(document, 'script', 'facebook-jssdk');
		</script>
	</head>
	<body>
		<div id="fb-root"></div>

		<div class="fade"></div>

		<div class="buttons">
			<slot name="buttons" />
		</div>

		<header>
			<slot name="header" />
		</header>

		<main>
			<slot name="main" />
		</main>

		<footer>
			<iframe
				src="https://ghbtns.com/github-btn.html?user=0xb4lint&repo=targygraf&type=star&count=true&size=large"
				class="github"></iframe>
			<div class="disclaimer">Az oldalon található információk nem tekinthetőek hivatalos forrásnak.</div>
		</footer>

		<script is:inline src="/assets/js/notie.min.js"></script>
		<script is:inline src="/assets/js/targygraf.js?v=20260830"></script>
		{
			migrateUniversity && (
				<script
					is:inline
					set:html={`window.lsMigrateUniversity=${JSON.stringify(migrateUniversity)};`}
				/>
			)
		}
		{migrateUniversity && <script is:inline src="/assets/js/ls-migrate.js?v=1"></script>}
	</body>
</html>
