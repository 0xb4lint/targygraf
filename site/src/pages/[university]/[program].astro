---
/** Port of resources/views/layouts/program.blade.php (ProgramController). */
import CreditsCounter from '../../components/CreditsCounter.astro';
import Help from '../../components/Help.astro';
import ProgramSelector from '../../components/ProgramSelector.astro';
import Progressbar from '../../components/Progressbar.astro';
import TargygrafContent from '../../components/Targygraf.astro';
import Template from '../../layouts/Template.astro';
import { getDataset, type Program, type University } from '../../lib/data';
import { isCurriculumOutdated } from '../../lib/render';
import { canonicalUrl, programPath, universityPath } from '../../lib/urls';

export function getStaticPaths() {
	return getDataset().universities.flatMap((university) =>
		university.faculties.flatMap((faculty) =>
			faculty.programs.map((program) => ({
				params: { university: university.slug, program: program.slug },
				props: { university, program },
			}))
		)
	);
}

interface Props {
	university: University;
	program: Program;
}

const { university, program } = Astro.props;
const description = `${program.name} (${university.name}) interaktív mintatanterv: tantárgyak, előfeltételek és kreditek.`;
---

<Template
	page="program"
	htmlTitle={`${university.name} - ${program.name}`}
	description={description}
	canonical={canonicalUrl(programPath(university.slug, program.slug))}
	migrateUniversity={university.slug}
>
	<Fragment slot="buttons">
		<div class="button reset" title="Adatok törlése">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
				><path d="M12 3v9"></path><path d="M6.6 5.6a8 8 0 1 0 10.8 0"></path></svg
			>
		</div>
		<a href={universityPath(university.slug)} class="button university" title="Egyetem">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
				><path d="M3 21h18"></path><path d="M4 9h16"></path><path d="M12 3 4 9h16z"></path><path d="M6 9v12"></path><path d="M10 9v12"></path><path d="M14 9v12"></path><path d="M18 9v12"></path></svg
			>
		</a>
	</Fragment>

	<Fragment slot="header">
		<div class="crumbs header-mark">
			<a href="/" class="wordmark"><img src="/assets/img/logo-dark.svg" alt="Tárgygráf" width="77" height="20" /></a>
			<span class="crumb-sep" aria-hidden="true">/</span>
			<a href={universityPath(university.slug)} class="crumb-link">{university.name}</a>
			<span class="crumb-sep" aria-hidden="true">/</span>
			<span class="crumb-here">{program.name}</span>
		</div>
		{
			university.hasLogo && (
				<img class="university-logo" src={`/assets/img/logo/${university.slug}.svg`} />
			)
		}

		<ProgramSelector university={university} currentProgramSlug={program.slug} hidden />

		<h1>
			<a href={universityPath(university.slug)} class="muted">{university.name}</a> - {
				program.name
			}
		</h1>
		{program.description && <div class="program-description">{program.description}</div>}
		{
			program.curriculumUpdatedAt &&
				(isCurriculumOutdated(program.curriculumUpdatedAt) ? (
					<div class="program-curriculum-outdated">
						Ez egy régebbi (<b>{program.curriculumUpdatedAt}</b>) tanterv, hivatalos forrásból is
						ellenőrizd a tárgyaidat!
					</div>
				) : (
					<div class="program-curriculum-updated">
						Tanterv: <b>{program.curriculumUpdatedAt}</b>
					</div>
				))
		}
	</Fragment>

	<Fragment slot="main">
		<Help />
		<Progressbar />
		<CreditsCounter />
		<TargygrafContent program={program} />
	</Fragment>
</Template>
