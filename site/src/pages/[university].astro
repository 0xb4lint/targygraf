---
/**
 * University page: one curriculum sheet, continuing the landing page's
 * registry language. Faculties are ruled sections; programs are index rows
 * carrying real registry data (semesters, credits, curriculum year).
 */
import Template from '../layouts/Template.astro';
import { getDataset, type Program, type University } from '../lib/data';
import { canonicalUrl, homePath, programPath, universityPath } from '../lib/urls';

export function getStaticPaths() {
	return getDataset().universities.map((university) => ({
		params: { university: university.slug },
		props: { university },
	}));
}

interface Props {
	university: University;
}

const { university } = Astro.props;
const programCount = university.faculties.reduce((n, f) => n + f.programs.length, 0);
const description = `${university.name} interaktív mintatantervei: szakok, tantárgyak, előfeltételek és kreditek.`;

const semesterCount = (program: Program) =>
	program.blocks.filter((block) => block.row === 0).length;
const creditSum = (program: Program) =>
	program.blocks
		.filter((block) => block.row === 0)
		.flatMap((block) => block.courses)
		.reduce((sum, course) => sum + course.credits, 0);
const curriculumYear = (program: Program) => program.curriculumUpdatedAt?.slice(0, 4);
---

<Template
	page="university"
	htmlTitle={university.name}
	description={description}
	canonical={canonicalUrl(universityPath(university.slug))}
>
	<Fragment slot="header">
		<nav class="topbar">
			<div class="crumbs">
				<a href={homePath()} class="wordmark"><img src="/assets/img/logo.svg" alt="Tárgygráf" width="131" height="34" /></a>
				<span class="crumb-sep" aria-hidden="true">/</span>
				<span class="crumb-here">{university.name}</span>
			</div>
			<div class="topbar-side">
				<span class="topbar-note">since 2012</span>
				<span class="topbar-sep" aria-hidden="true">·</span>
				<a href="https://github.com/0xb4lint/targygraf" class="topbar-link" rel="noopener">GitHub</a>
			</div>
		</nav>
	</Fragment>

	<Fragment slot="main">
		<section class="uni-wrap">
			<div class="sheet">
				<div class="sheet-head">
					<span>Szakválasztó</span>
					<!--<span>{university.faculties.length} kar · {programCount} szak</span>-->
				</div>

				<div class="uni-identity">
					{
						university.hasLogo && (
							<img
								class="university-logo"
								src={`/assets/img/logo/${university.slug}.svg`}
								alt=""
							/>
						)
					}
					<span class="uni-code">{university.slug.toUpperCase()}</span>
					<h1>{university.name}</h1>
				</div>

				<div class="program-selector">
					{
						university.faculties.map((faculty) => (
							<div class="faculty">
								<div class="faculty-head">
									<div class="faculty-name">{faculty.name}</div>
									<!--<span class="faculty-count">{faculty.programs.length} szak</span>-->
								</div>
								{faculty.programs.map((program) => (
									<a href={programPath(university.slug, program.slug)} class="program">
										<span class="program-name">{program.name}</span>
										<span class="program-meta">
											{semesterCount(program)} félév · {creditSum(program)} kredit
											{curriculumYear(program) && ` · ${curriculumYear(program)}`}
										</span>
										<span class="arrow" aria-hidden="true">→</span>
									</a>
								))}
							</div>
						))
					}
				</div>
			</div>
		</section>
	</Fragment>
</Template>
