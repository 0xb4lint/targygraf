---
/** University page: identity + program picker (UniversityController port). */
import ProgramSelector from '../components/ProgramSelector.astro';
import Template from '../layouts/Template.astro';
import { getDataset, type University } from '../lib/data';
import { canonicalUrl, homePath, universityPath } from '../lib/urls';

export function getStaticPaths() {
	return getDataset().universities.map((university) => ({
		params: { university: university.slug },
		props: { university },
	}));
}

interface Props {
	university: University;
}

const { university } = Astro.props;
const programCount = university.faculties.reduce((n, f) => n + f.programs.length, 0);
const description = `${university.name} interaktív mintatantervei: szakok, tantárgyak, előfeltételek és kreditek.`;
---

<Template
	page="university"
	htmlTitle={university.name}
	description={description}
	canonical={canonicalUrl(universityPath(university.slug))}
	migrateUniversity={university.slug}
>
	<Fragment slot="buttons">
		<a href={homePath()} class="button" title="targygraf.hu">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
				><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path><path d="M10 21v-6h4v6"></path></svg
			>
		</a>
	</Fragment>

	<Fragment slot="header">
		<nav class="topbar">
			<div class="crumbs">
				<a href={homePath()} class="wordmark"><img src="/assets/img/logo.svg" alt="Tárgygráf" width="131" height="34" /></a>
				<span class="crumb-sep" aria-hidden="true">/</span>
				<span class="crumb-here">{university.name}</span>
			</div>
			<div class="topbar-side">
				<span class="topbar-note">since 2012</span>
				<span class="topbar-sep" aria-hidden="true">·</span>
				<a href="https://github.com/0xb4lint/targygraf" class="topbar-link" rel="noopener">GitHub</a>
			</div>
		</nav>
	</Fragment>

	<Fragment slot="main">
		<div class="uni-hero">
			{
				university.hasLogo && (
					<img
						class="university-logo"
						src={`/assets/img/logo/${university.slug}.svg`}
						alt={university.name}
					/>
				)
			}
			<h1>{university.name}</h1>
			<p class="uni-meta">
				{university.faculties.length} kar · {programCount} szak
			</p>
		</div>

		<ProgramSelector university={university} />
	</Fragment>
</Template>
