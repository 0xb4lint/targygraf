---
/** Port of resources/views/layouts/university.blade.php (UniversityController). */
import ProgramSelector from '../components/ProgramSelector.astro';
import Template from '../layouts/Template.astro';
import { getDataset, type University } from '../lib/data';
import { canonicalUrl, homePath, universityPath } from '../lib/urls';

export function getStaticPaths() {
	return getDataset().universities.map((university) => ({
		params: { university: university.slug },
		props: { university },
	}));
}

interface Props {
	university: University;
}

const { university } = Astro.props;
const description = `${university.name} interaktív mintatantervei: szakok, tantárgyak, előfeltételek és kreditek.`;
---

<Template
	htmlTitle={university.name}
	description={description}
	canonical={canonicalUrl(universityPath(university.slug))}
	migrateUniversity={university.slug}
>
	<Fragment slot="buttons">
		<a href={homePath()} class="button" title="targygraf.hu"><i class="fa fa-home"></i></a>
	</Fragment>

	<Fragment slot="header">
		<ProgramSelector university={university} />
	</Fragment>

	<Fragment slot="main">
		{
			university.hasLogo && (
				<img class="university-logo" src={`/assets/img/logo/${university.slug}.svg`} />
			)
		}

		<h1>{university.name}</h1>
	</Fragment>
</Template>
