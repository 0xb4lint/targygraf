---
/**
 * The color legend. It introduces itself for a few seconds, then folds down
 * into the swatch chip in the corner (see enableHelpToggle in targygraf.js);
 * clicking the chip folds it back out.
 */
---

<div class="help">
	<button
		class="help-toggle"
		type="button"
		aria-expanded="true"
		aria-controls="help-legend"
		aria-label="Jelmagyarázat"
	>
		<span class="help-swatches" aria-hidden="true">
			<i class="swatch-inert"></i>
			<i class="swatch-open"></i>
			<i class="swatch-taken"></i>
			<i class="swatch-done"></i>
			<i class="swatch-prereq"></i>
			<i class="swatch-sequel"></i>
		</span>
	</button>

	<div class="help-legend" id="help-legend">
		<div class="course-help" title="Nem teljesítetted az előfeltételeket.">Nem vehető fel</div>
		<div
			class="course-help processable"
			title="Teljesített az előfeltételeket,<br>lehetőséged van felvenni a tárgyat."
		>
			Felvehető<span class="help-sub">(ha meg van hirdetve)</span>
		</div>
		<div class="course-help processing" title="Felvetted a tárgyat.">Felvett</div>
		<div class="course-help finished" title="Teljesítetted a tárgyat.">Teljesített</div>
		<div
			class="course-help prerequisite"
			title="Kiválasztott tárgy felvételéhez<br>szükséges előfeltételek."
		>
			Előfeltétel
		</div>
		<div
			class="course-help sequel"
			title="Azon tárgyak melyek a kiválasztott<br>tantárgyra épülnek."
		>
			Ráépülés
		</div>
	</div>
</div>
